  "elements": [
    {
      "seed": 309321236,
      "strokeStyle": "solid",
      "id": "1R2_NnQZ8QGqdTrrIbdpR",
      "strokeWidth": 2,
      "roughness": 1,
      "isDeleted": false,
      "fontSize": 36,
      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1790804704496,
      "locked": false,
      "text": "Perché ho scelto questo percorso",
      "version": 266,
      "autoResize": false,
      "type": "text",
      "backgroundColor": "transparent",
      "index": "a1",
      "roundness": null,
      "containerId": null,
      "originalText": "Perché ho scelto questo percorso",
      "height": 45,
      "link": null,
      "strokeColor": "#e03131",
      "fillStyle": "solid",
      "groupIds": [],
      "versionNonce": 1705799619,
      "textAlign": "left",
      "fontFamily": 5,
      "lineHeight": 1.25,
      "frameId": null,
      "boundElements": [],
      "x": -109.88519865026547,
      "angle": 0,
      "y": 1086.8260997608645,
      "width": 603.3367150878905,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "seed": 460411540,
      "strokeStyle": "solid",
      "id": "DuZx4fsQcMaVdviIVjpHn",
      "strokeWidth": 2,
      "roughness": 1,
      "isDeleted": false,
      "fontSize": 20,
      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1790804702545,
      "locked": false,
      "text": "Ho scelto lo stack Node.js/Express perché mi permette di lavorare con un solo linguaggio, JavaScript, sia sul frontend che sul backend: questo mi consente di concentrare l'apprendimento invece di dividerlo tra due\nlinguaggi diversi, ed è anche lo stack più diffuso nell'ambito delle applicazioni web moderne. Rispetto a un framework più \"strutturato\" come Laravel, Express mi obbliga a costruire a mano molte parti (routing, middleware,\ngestione dell'autenticazione), il che mi aiuta a capire meglio cosa succede davvero dietro le quinte di una REST API.",
      "version": 335,
      "autoResize": false,
      "type": "text",
      "backgroundColor": "transparent",
      "index": "a3",
      "roundness": null,
      "containerId": null,
      "originalText": "Ho scelto lo stack Node.js/Express perché mi permette di lavorare con un solo linguaggio, JavaScript, sia sul frontend che sul backend: questo mi consente di concentrare l'apprendimento invece di dividerlo tra due linguaggi diversi, ed è anche lo stack più diffuso nell'ambito delle applicazioni web moderne. Rispetto a un framework più \"strutturato\" come Laravel, Express mi obbliga a costruire a mano molte parti (routing, middleware, gestione dell'autenticazione), il che mi aiuta a capire meglio cosa succede davvero dietro le quinte di una REST API.",
      "height": 75,
      "link": null,
      "strokeColor": "#1e1e1e",
      "fillStyle": "solid",
      "groupIds": [],
      "versionNonce": 1078817123,
      "textAlign": "left",
      "fontFamily": 5,
      "lineHeight": 1.25,
      "frameId": null,
      "boundElements": [],
      "x": -109.64977636683852,
      "angle": 0,
      "y": 1153.3280878841206,
      "width": 2124.7788278641137,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "seed": 981035156,
      "strokeStyle": "solid",
      "id": "K9pZjued36Vd8WO7bTplg",
      "strokeWidth": 2,
      "roughness": 1,
      "isDeleted": false,
      "fontSize": 20,
      "opacity": 100,
      "verticalAlign": "top",
      "updated": 1790804707796,
      "locked": false,
      "text": "Per il progetto ho scelto di sviluppare DayByDay, un'applicazione che unisce il concetto di calendario e agenda insieme, con la possibilità per l'utente di creare sia calendari personali che calendari condivisi con altre\npersone (famiglia, coinquilini, gruppi di studio). Il nome esprime l'idea con cui è nata: con il calendario viviamo giorno per giorno, organizzando un giorno alla volta impegni, note e cose da fare. Ho preferito questa idea ad\naltre più semplici perché, oltre a interessarmi personalmente, presenta sfide tecniche più stimolanti: gestire non solo il CRUD di eventi, ma anche relazioni tra più utenti, permessi di accesso e condivisione dei dati. È inoltre\nun progetto che ha senso continuare a sviluppare oltre l'esame: parto da un MVP con autenticazione, gestione di eventi, note e to-do, e la doppia modalità personale/condivisa con notifiche, con l'idea di aggiungere in\nfuturo funzionalità come la cessione dell'amministrazione, regole di ricorrenza più flessibili o integrazioni con altri calendari.",
      "version": 522,
      "autoResize": false,
      "type": "text",
      "backgroundColor": "transparent",
      "index": "a4",
      "roundness": null,
      "containerId": null,
      "originalText": "Per il progetto ho scelto di sviluppare DayByDay, un'applicazione che unisce il concetto di calendario e agenda insieme, con la possibilità per l'utente di creare sia calendari personali che calendari condivisi con altre persone (famiglia, coinquilini, gruppi di studio). Il nome esprime l'idea con cui è nata: con il calendario viviamo giorno per giorno, organizzando un giorno alla volta impegni, note e cose da fare. Ho preferito questa idea ad altre più semplici perché, oltre a interessarmi personalmente, presenta sfide tecniche più stimolanti: gestire non solo il CRUD di eventi, ma anche relazioni tra più utenti, permessi di accesso e condivisione dei dati. È inoltre un progetto che ha senso continuare a sviluppare oltre l'esame: parto da un MVP con autenticazione, gestione di eventi, note e to-do, e la doppia modalità personale/condivisa con notifiche, con l'idea di aggiungere in futuro funzionalità come la cessione dell'amministrazione, regole di ricorrenza più flessibili o integrazioni con altri calendari.",
      "height": 125,
      "link": null,
      "strokeColor": "#1e1e1e",
      "fillStyle": "solid",
