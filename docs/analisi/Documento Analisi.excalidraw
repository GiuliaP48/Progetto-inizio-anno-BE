      "strokeColor": "#1e1e1e",
      "fillStyle": "solid",
      "groupIds": [],
      "versionNonce": 1526841022,
      "textAlign": "left",
      "fontFamily": 5,
      "lineHeight": 1.25,
      "frameId": null,
      "boundElements": [],
      "x": 1456.1235733605135,
